{
  "name": "soundclaw",
  "version": "0.2.0",
  "type": "module",
  "description": "A sound effects and music workbench for AI agents: sounds made from parameters and recordings by command through an MCP server and a CLI, with a live browser view where people listen and edit.",
  "license": "MIT",
  "author": "Chris Crabtree",
  "homepage": "https://github.com/retrodigio/soundclaw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retrodigio/soundclaw.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/retrodigio/soundclaw/issues"
  },
  "keywords": [
    "sound-effects",
    "sfx",
    "music",
    "audio",
    "synth",
    "game-audio",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agent",
    "cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "soundclaw": "dist/soundclaw.js"
  },
  "files": [
    "dist/soundclaw.js",
    "dist/thumbs-worker.js",
    "dist/decode-worker.js",
    "dist/library-worker.js",
    "dist/samplecards-worker.js",
    "dist/instrumentcheck-worker.js",
    "dist/ui/",
    "dist/skill/",
    "dist/LICENSE",
    "dist/THIRD_PARTY_LICENSES.txt"
  ],
  "dependencies": {
    "libvorbis.js": "^1.1.2"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').accessSync('dist/soundclaw.js')\" || (echo 'run pnpm build at the repo root first' && exit 1)"
  },
  "devDependencies": {
    "@soundclaw/core": "workspace:*",
    "@soundclaw/server": "workspace:*"
  }
}
